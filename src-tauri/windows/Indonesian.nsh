LangString addOrReinstall ${LANG_INDONESIAN} "Tambah atau pasang ulang komponen"
LangString alreadyInstalled ${LANG_INDONESIAN} "Sudah terpasang"
LangString alreadyInstalledLong ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terpasang. Pilih tindakan yang ingin dilakukan, lalu klik Next untuk melanjutkan."
LangString appRunning ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan. Tutup dulu, lalu coba lagi."
LangString appRunningOkKill ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan.$\nKlik OK untuk menutupnya."
LangString chooseMaintenanceOption ${LANG_INDONESIAN} "Pilih jenis pemeliharaan yang ingin dilakukan."
LangString choowHowToInstall ${LANG_INDONESIAN} "Pilih cara memasang ${PRODUCTNAME}."
LangString createDesktop ${LANG_INDONESIAN} "Buat shortcut di desktop"
LangString deleteAppData ${LANG_INDONESIAN} "Hapus data aplikasi"
LangString dontUninstall ${LANG_INDONESIAN} "Jangan copot pemasangan"
LangString dontUninstallDowngrade ${LANG_INDONESIAN} "Jangan copot pemasangan (memasang versi lebih lama tanpa mencopot versi sekarang tidak diizinkan)"
LangString failedToKillApp ${LANG_INDONESIAN} "${PRODUCTNAME} tidak bisa ditutup. Tutup dulu, lalu coba lagi."
LangString installingWebview2 ${LANG_INDONESIAN} "Memasang WebView2..."
LangString newerVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang lebih baru sudah terpasang. Memasang versi lama tidak disarankan. Kalau tetap ingin memasangnya, sebaiknya copot versi sekarang dulu. Pilih tindakan yang ingin dilakukan, lalu klik Next untuk melanjutkan."
LangString older ${LANG_INDONESIAN} "lebih lama"
LangString olderOrUnknownVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang $R4 sudah terpasang. Sebaiknya copot versi itu sebelum memasang. Pilih tindakan yang ingin dilakukan, lalu klik Next untuk melanjutkan."
LangString silentDowngrades ${LANG_INDONESIAN} "Memasang versi lebih lama tidak diizinkan untuk installer ini, jadi pemasangan tanpa tampilan tidak bisa dilanjutkan. Jalankan installer dengan tampilan biasa.$\n"
LangString unableToUninstall ${LANG_INDONESIAN} "Pemasangan tidak bisa dicopot."
LangString uninstallApp ${LANG_INDONESIAN} "Copot ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_INDONESIAN} "Copot dulu sebelum memasang"
LangString unknown ${LANG_INDONESIAN} "tidak diketahui"
LangString webview2AbortError ${LANG_INDONESIAN} "WebView2 gagal dipasang. Aplikasi tidak bisa berjalan tanpanya. Coba jalankan ulang installer."
LangString webview2DownloadError ${LANG_INDONESIAN} "Error: WebView2 gagal diunduh - $0"
LangString webview2DownloadSuccess ${LANG_INDONESIAN} "Bootstrapper WebView2 berhasil diunduh"
LangString webview2Downloading ${LANG_INDONESIAN} "Mengunduh bootstrapper WebView2..."
LangString webview2InstallError ${LANG_INDONESIAN} "Error: Pemasangan WebView2 gagal dengan kode keluar $1"
LangString webview2InstallSuccess ${LANG_INDONESIAN} "WebView2 berhasil dipasang"
